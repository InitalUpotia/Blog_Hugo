{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "HUGO_VERSION": "0.167.0"
    }
  },
  "buildCommand": "hugo --gc --minify",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}